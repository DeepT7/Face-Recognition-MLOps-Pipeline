name: "face_matching_model"
platform: "onnxruntime_onnx"
max_batch_size: 4
input [
    {
        name: "input"
        data_type: TYPE_FP32
        dims: [3, 112, 112] 
    }
]
output [
    {
        name: "output"
        data_type: TYPE_FP32
        dims: [512]
    }
]

# Add this for a massive performance boost!
dynamic_batching {
  max_queue_delay_microseconds: 100
}
